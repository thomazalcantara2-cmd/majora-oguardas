# Copie para .env.local para rodar localmente (npm run dev / npm run seed).
# Em produção, essas variáveis vivem nas Environment Variables do projeto no
# Vercel — DATABASE_URL e BLOB_READ_WRITE_TOKEN são injetadas automaticamente
# quando você conecta Neon Postgres e Vercel Blob na aba Storage. Veja README.md.

# Postgres (Neon, via Vercel Storage)
DATABASE_URL=

# Vercel Blob (upload do PDF do recurso gerado em tempo real)
BLOB_READ_WRITE_TOKEN=

# String aleatória longa usada para assinar o token de sessão pós-senha.
# Gere uma com: openssl rand -base64 32
SESSION_SECRET=
