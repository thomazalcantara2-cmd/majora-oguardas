# Copie para .env.local para rodar localmente (npm run dev).
# Em produção, essas variáveis vivem nas Environment Variables do projeto no
# Vercel. Veja README.md para o passo a passo completo (implantar o Web App
# do Apps Script, gerar o token, etc.).

# URL do Web App do Apps Script (apps-script/Code.gs), depois de implantado
# (Implantar → Nova implantação → App da Web). Termina em /exec.
APPS_SCRIPT_URL=

# Token gerado pela função definirToken() do apps-script/Code.gs.
APPS_SCRIPT_TOKEN=

# Vercel Blob (upload do PDF do recurso gerado em tempo real)
BLOB_READ_WRITE_TOKEN=

# String aleatória longa usada para assinar o token de sessão pós-senha.
# Gere uma com: openssl rand -base64 32
SESSION_SECRET=
