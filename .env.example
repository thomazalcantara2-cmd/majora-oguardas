# Copie para .env.local para rodar localmente (npm run dev / scripts).
# Em produção, essas variáveis vivem nas Environment Variables do projeto no
# Vercel. Veja README.md para o passo a passo completo (criar a conta de
# serviço do Google, compartilhar a planilha com ela, etc.).

# ID da planilha (a parte da URL entre /d/ e /edit)
GOOGLE_SHEETS_SPREADSHEET_ID=1DK-qyKKTYoQn56BIWVXyVnp0JwJhJi0vCtc0uAR9I-E

# Nome exato da aba (a etiqueta que aparece embaixo, na planilha) onde estão
# as colunas CPF, MATR., NOME, CLASSE, STATUS, Recurso etc.
GOOGLE_SHEETS_TAB_NAME=

# Conta de serviço do Google (Google Cloud) com a Sheets API habilitada,
# compartilhada como Editor na planilha acima.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Cole a chave privada exatamente como veio no JSON baixado do Google Cloud,
# incluindo as quebras de linha (na Vercel, cole com quebras de linha reais;
# em .env.local, pode usar \n escapado — o código trata os dois casos).
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Vercel Blob (upload do PDF do recurso gerado em tempo real)
BLOB_READ_WRITE_TOKEN=

# String aleatória longa usada para assinar o token de sessão pós-senha.
# Gere uma com: openssl rand -base64 32
SESSION_SECRET=
